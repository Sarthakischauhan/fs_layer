{
  "name": "fs-layer",
  "version": "0.1.0",
  "description": "Agentic knowledge-base explorer backed by ChromaDB and just-bash.",
  "private": true,
  "keywords": [
    "agents",
    "react",
    "langgraph",
    "langchain",
    "just-bash",
    "chromadb",
    "neo4j",
    "filesystem",
    "chromafs",
    "llm",
    "tui"
  ],
  "license": "MIT",
  "author": "Sarthak Chauhan <sarthakchauhann@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "start": "node --env-file=.env dist/main.js",
    "tui": "node --env-file=.env --import=tsx/esm src/main.tsx",
    "dev": "node --env-file=.env --import=tsx/esm --watch src/main.tsx",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@sarchauhan/adapter": "^0.0.1",
    "@sarchauhan/chat-tui": "^0.0.1",
    "@sarchauhan/protocol": "^0.0.1",
    "ink": "^7.1.1",
    "micromatch": "^4.0.8",
    "react": "^19.2.3",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/openai": "^1.5.6",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/yargs-parser": "^21.0.3",
    "chromadb": "^1.10.0",
    "just-bash": "^3.2.0",
    "langchain": "^1.5.5",
    "neo4j-driver": "^5.28.0",
    "openai": "^6.21.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sarthakischauhan/fs_layer.git"
  },
  "homepage": "https://github.com/Sarthakischauhan/fs_layer#readme"
}
